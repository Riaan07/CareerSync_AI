@model AppUserDashboardViewModel
@{
    ViewData["Title"] = "Overview";
    ViewData["PageTitle"] = "Overview";
    ViewData["Active"] = "Overview";
    ViewData["UserName"] = Model.FullName;
    ViewData["UserInitials"] = string.Join("", Model.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(p => p[0])).ToUpper();
    Layout = "_AppUserLayout";

    const double circumference = 314.0;
    var ringOffset = circumference - (circumference * Model.LatestMatchScore / 100.0);
    var firstName = Model.FullName.Split(' ').FirstOrDefault() ?? Model.FullName;
    var completedSegments = (int)Math.Round(Model.ProfileCompletionPercent / 20.0);

    var sparkScores = Model.RecentUploads.Select(u => u.Score).Reverse().ToList();
    string sparkPoints = "", sparkFillPoints = "";
    if (sparkScores.Count >= 2)
    {
        var stepX = 90.0 / (sparkScores.Count - 1);
        var pts = sparkScores.Select((s, i) => $"{(i * stepX).ToString("0.#")},{(28 - s / 100.0 * 28).ToString("0.#")}").ToList();
        sparkPoints = string.Join(" ", pts);
        sparkFillPoints = sparkPoints + " 90,28 0,28";
    }
}

@if (ViewData["StatusMessage"] is string status)
{
    <div class="status-banner">@status</div>
}

<div class="welcome-band">
    <div>
        <h2>Welcome back, @firstName 👋</h2>
        @if (Model.LatestMatch != null)
        {
            <p>You're @(Model.LatestMatchScore)% matched to your latest role — @Model.OpenSkillGapsCount skill gap@(Model.OpenSkillGapsCount == 1 ? "" : "s") stand@(Model.OpenSkillGapsCount == 1 ? "s" : "") between you and a stronger application.</p>
        }
        else
        {
            <p>Upload your CV and a job description to see your first match score and skill gap report.</p>
        }
        <div class="progress-strip">
            @for (var i = 0; i < 5; i++)
            {
                <div class="seg @(i < completedSegments ? "done" : "")"></div>
            }
            <span class="lbl">PROFILE @Model.ProfileCompletionPercent% COMPLETE</span>
        </div>
    </div>
    <div class="welcome-actions">
        <a class="btn btn-on-dark btn-lg" asp-controller="AppUser" asp-action="Analyze">+ Analyse a CV against a job</a>
    </div>
</div>

<div class="stat-row">
    <div class="stat-card">
        <div class="stat-top-row">
            <div>
                <div class="lbl">LATEST MATCH SCORE</div>
                <div class="val mono">@(Model.LatestMatch != null ? $"{Model.LatestMatchScore}%" : "—")</div>
                @if (Model.LatestMatch == null)
                {
                    <div class="delta" style="color:var(--slate-light);">No analyses yet</div>
                }
                else if (Model.ScoreChangeSinceLastUpload != 0)
                {
                    <div class="delta @(Model.ScoreChangeSinceLastUpload < 0 ? "warn" : "")">@(Model.ScoreChangeSinceLastUpload > 0 ? "↑" : "↓") @(Math.Abs(Model.ScoreChangeSinceLastUpload))% since last upload</div>
                }
                else
                {
                    <div class="delta" style="color:var(--slate-light);">First analysis</div>
                }
            </div>
            @if (!string.IsNullOrEmpty(sparkPoints))
            {
                <svg class="sparkline" width="72" height="30" viewBox="0 0 90 28">
                    <defs>
                        <linearGradient id="sparkFill" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0" stop-color="#0E9C8F" stop-opacity="0.18" />
                            <stop offset="1" stop-color="#0E9C8F" stop-opacity="0" />
                        </linearGradient>
                    </defs>
                    <polygon points="@sparkFillPoints" fill="url(#sparkFill)" />
                    <polyline points="@sparkPoints" fill="none" stroke="#0E9C8F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            }
        </div>
    </div>
    <div class="stat-card">
        <div class="lbl">CVs ANALYSED</div>
        <div class="val mono">@Model.CvsAnalysedCount</div>
        <div class="delta" style="color:var(--slate-light);">Across @Model.JobPostingsComparedCount job@(Model.JobPostingsComparedCount == 1 ? "" : "s") applied for</div>
    </div>
    <div class="stat-card">
        <div class="lbl">OPEN SKILL GAPS</div>
        <div class="val mono">@Model.OpenSkillGapsCount</div>
        @if (Model.LatestMatch != null)
        {
            <div class="delta warn">From your most recent match</div>
        }
        else
        {
            <div class="delta" style="color:var(--slate-light);">Nothing analysed yet</div>
        }
    </div>
</div>

<div class="dash-grid">
    <div>
        <div class="card card-accent" style="margin-bottom:20px;">
            <div class="card-head">
                <div>
                    <h3>Latest match</h3>
                    <div class="meta">Analysed @(Model.LatestMatch != null ? Model.LatestMatch.GeneratedAt.ToString("d MMM") : "—")</div>
                </div>
                @if (Model.LatestMatch != null)
                {
                    <div style="display:flex; align-items:center; gap:12px;">
                        <span class="pill pill-teal">@(Model.LatestMatchScore >= 70 ? "GOOD MATCH" : "NEEDS WORK")</span>
                        <a class="btn-text" asp-controller="AppUser" asp-action="MatchDetail" asp-route-id="@Model.LatestMatch.Id">Details →</a>
                    </div>
                }
            </div>

            @if (Model.LatestMatch != null)
            {
                <div class="match-ring-row">
                    <div class="mini-ring">
                        <svg width="120" height="120" viewBox="0 0 120 120">
                            <circle cx="60" cy="60" r="50" fill="none" stroke="#E3E9ED" stroke-width="9" />
                            <circle cx="60" cy="60" r="50" fill="none" stroke="#0E9C8F" stroke-width="9" stroke-linecap="round"
                                    stroke-dasharray="314" stroke-dashoffset="@ringOffset.ToString("0.##")" transform="rotate(-90 60 60)" />
                        </svg>
                        <div class="pct">@Model.LatestMatchScore%</div>
                    </div>
                    <div class="match-copy">
                        <div class="job-title">@Model.LatestMatchJobTitle</div>
                        <div class="job-meta">@Model.LatestMatchCompany</div>
                        <div class="job-meta">Uploaded: @Model.LatestMatchCvFileName</div>
                    </div>
                </div>

                <div class="bar-row">
                    <div class="bar-top"><span>Technical skills</span><span class="mono">@Model.LatestMatch.TechnicalSkillsScore%</span></div>
                    <div class="bar-track"><div class="bar-fill" style="width:@(Model.LatestMatch.TechnicalSkillsScore)%;"></div></div>
                </div>
                <div class="bar-row">
                    <div class="bar-top"><span>Experience</span><span class="mono">@Model.LatestMatch.ExperienceScore%</span></div>
                    <div class="bar-track"><div class="bar-fill" style="width:@(Model.LatestMatch.ExperienceScore)%; background:var(--amber);"></div></div>
                </div>
                <div class="bar-row">
                    <div class="bar-top"><span>Qualifications</span><span class="mono">@Model.LatestMatch.QualificationsScore%</span></div>
                    <div class="bar-track"><div class="bar-fill" style="width:@(Model.LatestMatch.QualificationsScore)%;"></div></div>
                </div>

                <div style="margin-top:20px;">
                    <div class="meta" style="margin-bottom:10px; font-family:'IBM Plex Mono'; font-size:11px; letter-spacing:.06em; color:var(--slate-light);">SKILLS DETECTED</div>
                    <div class="chip-wrap">
                        @foreach (var skill in Model.LatestMatch.MatchedSkills)
                        {
                            <span class="chip chip-ok">@skill ✓</span>
                        }
                        @foreach (var gap in Model.LatestMatch.GapSkills)
                        {
                            <span class="chip chip-gap">@gap — gap</span>
                        }
                    </div>
                </div>
            }
            else
            {
                <div style="text-align:center; padding:32px 16px;">
                    <p style="font-size:13.5px; color:var(--slate); line-height:1.6; margin:0 0 16px;">You haven't analysed a CV yet. Upload one and add a job description to see your compatibility score, skill gaps, and recommendations here.</p>
                    <a class="btn btn-primary" asp-controller="AppUser" asp-action="Analyze">+ Analyse your CV</a>
                </div>
            }
        </div>

        <div class="card">
            <div class="card-head">
                <div><h3>Recent uploads</h3><div class="meta">@(Model.RecentUploads.Count > 0 ? $"Your last {Model.RecentUploads.Count} CV / job comparisons" : "No comparisons yet")</div></div>
                @if (Model.RecentUploads.Count > 0)
                {
                    <a class="btn-text" asp-controller="AppUser" asp-action="History">View all →</a>
                }
            </div>
            @if (Model.RecentUploads.Count > 0)
            {
                <table class="recent">
                    <tr><th>CV</th><th>Matched against</th><th>Date</th><th>Score</th></tr>
                    @foreach (var upload in Model.RecentUploads)
                    {
                        var badgeColor = upload.Score >= 70 ? "background:rgba(14,156,143,0.1); color:var(--teal-dark);"
                                        : upload.Score >= 50 ? "background:rgba(242,163,64,0.15); color:#C97F1F;"
                                        : "background:rgba(232,92,74,0.12); color:var(--coral);";
                        <tr>
                            <td>@upload.CvFileName</td>
                            <td><a asp-controller="AppUser" asp-action="MatchDetail" asp-route-id="@upload.MatchId" style="color:var(--navy); font-weight:600;">@upload.JobTitle</a><div class="sub">@upload.Company</div></td>
                            <td>@upload.Date.ToString("d MMM yyyy")</td>
                            <td><span class="score-badge" style="@badgeColor">@upload.Score%</span></td>
                        </tr>
                    }
                </table>
            }
            else
            {
                <p style="font-size:13.5px; color:var(--slate-light); margin:8px 0 0;">No CVs analysed yet — your comparisons will show up here.</p>
            }
        </div>
    </div>

    <div>
        <div class="card">
            <div class="card-head">
                <div><h3>Recommended learning</h3><div class="meta">Based on your open gaps</div></div>
            </div>
            @if (Model.RecommendedResources.Count > 0)
            {
                @foreach (var resource in Model.RecommendedResources)
                {
                    var isCert = resource.Type == LearningResourceType.Certification;
                    <div class="learn-item">
                        <div class="learn-ic" style="@(isCert ? "background:rgba(242,163,64,0.16);" : "")">
                            @if (isCert)
                            {
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C97F1F" stroke-width="2"><circle cx="12" cy="8" r="6" /><path d="M9 13.5L7 22l5-3 5 3-2-8.5" /></svg>
                            }
                            else
                            {
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#122647" stroke-width="2"><path d="M9 21V9m6 12V3m-12 18v-6" /></svg>
                            }
                        </div>
                        <div>
                            <span class="learn-tag learn-tag-gap">CLOSES: @resource.SkillName.ToUpper()</span>
                            @if (isCert)
                            {
                                <span class="learn-tag" style="background:rgba(242,163,64,0.16); color:#C97F1F;">CERTIFICATE</span>
                            }
                            <h4>@resource.Title</h4>
                            <div class="meta">@resource.Provider &middot; @resource.DurationHours hrs</div>
                        </div>
                        <a class="go" href="@resource.Url" target="_blank" rel="noopener">Start →</a>
                    </div>
                }
            }
            else
            {
                <p style="font-size:13.5px; color:var(--slate-light); margin:8px 0 0;">Complete your first analysis to get personalised course recommendations.</p>
            }
        </div>

        <div class="card" style="margin-top:20px;">
            <div class="card-head"><div><h3>Tip</h3></div></div>
            <p style="font-size:13.5px; color:var(--slate); line-height:1.6; margin:0;">Roles with a 65%+ match are worth applying to now — the remaining gap is usually covered in the interview, not before it.</p>
        </div>
    </div>
</div>
