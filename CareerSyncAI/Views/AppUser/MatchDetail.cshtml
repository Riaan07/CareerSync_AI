@model MatchDetailViewModel
@{
    ViewData["Title"] = "Match details";
    ViewData["PageTitle"] = "Match details";
    ViewData["Active"] = "History";
    ViewData["UserName"] = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Graduate";
    var nameForInitials = ViewData["UserName"] as string ?? "Graduate";
    ViewData["UserInitials"] = string.Join("", nameForInitials.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(p => p[0])).ToUpper();
    Layout = "_AppUserLayout";
    var m = Model.Match;
    var ringOffset = 314.0 - (314.0 * m.OverallScore / 100.0);
}

<div style="margin-bottom:14px;"><a class="btn-text" asp-controller="AppUser" asp-action="History">← All analyses</a></div>

<div class="dash-grid">
    <div>
        <div class="card card-accent" style="margin-bottom:20px;">
            <div class="card-head">
                <div>
                    <h3>@Model.JobTitle</h3>
                    <div class="meta">@(string.IsNullOrEmpty(Model.Company) ? "" : Model.Company + " · ")Analysed @m.GeneratedAt.ToString("d MMM yyyy, HH:mm")</div>
                </div>
                <span class="pill pill-teal">@(m.OverallScore >= 70 ? "GOOD MATCH" : "NEEDS WORK")</span>
            </div>

            <div class="match-ring-row">
                <div class="mini-ring">
                    <svg width="120" height="120" viewBox="0 0 120 120">
                        <circle cx="60" cy="60" r="50" fill="none" stroke="#E3E9ED" stroke-width="9" />
                        <circle cx="60" cy="60" r="50" fill="none" stroke="#0E9C8F" stroke-width="9" stroke-linecap="round"
                                stroke-dasharray="314" stroke-dashoffset="@ringOffset.ToString("0.##")" transform="rotate(-90 60 60)" />
                    </svg>
                    <div class="pct">@m.OverallScore%</div>
                </div>
                <div class="match-copy">
                    <div class="job-title">Overall compatibility</div>
                    <div class="job-meta">CV: @Model.CvFileName</div>
                    <div class="job-meta">Weighting: technical @Model.Weights.TechnicalSkillsWeight% · experience @Model.Weights.ExperienceWeight% · qualifications @Model.Weights.QualificationsWeight%</div>
                </div>
            </div>

            <div class="bar-row">
                <div class="bar-top"><span>Technical skills</span><span class="mono">@m.TechnicalSkillsScore%</span></div>
                <div class="bar-track"><div class="bar-fill" style="width:@(m.TechnicalSkillsScore)%;"></div></div>
            </div>
            <div class="bar-row">
                <div class="bar-top"><span>Experience</span><span class="mono">@m.ExperienceScore%</span></div>
                <div class="bar-track"><div class="bar-fill" style="width:@(m.ExperienceScore)%; background:var(--amber);"></div></div>
            </div>
            <div class="bar-row">
                <div class="bar-top"><span>Qualifications</span><span class="mono">@m.QualificationsScore%</span></div>
                <div class="bar-track"><div class="bar-fill" style="width:@(m.QualificationsScore)%;"></div></div>
            </div>

            <div style="margin-top:20px;">
                <div class="meta" style="margin-bottom:10px; font-family:'IBM Plex Mono'; font-size:11px; letter-spacing:.06em; color:var(--slate-light);">SKILLS</div>
                <div class="chip-wrap">
                    @foreach (var skill in m.MatchedSkills)
                    {
                        <span class="chip chip-ok">@skill ✓</span>
                    }
                    @foreach (var gap in m.GapSkills)
                    {
                        <span class="chip chip-gap">@gap — gap</span>
                    }
                    @if (m.MatchedSkills.Count == 0 && m.GapSkills.Count == 0)
                    {
                        <span style="font-size:13px; color:var(--slate-light);">No dictionary skills were found in this job description.</span>
                    }
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-head"><div><h3>Job description</h3><div class="meta">As submitted</div></div></div>
            <p style="font-size:13.5px; color:var(--slate); line-height:1.6; margin:0; white-space:pre-line;">@Model.JobDescriptionText</p>
        </div>
    </div>

    <div>
        <div class="card">
            <div class="card-head"><div><h3>Close the gaps</h3><div class="meta">Courses &amp; certificates for this role's missing skills</div></div></div>
            @if (Model.RecommendedResources.Count > 0)
            {
                @foreach (var r in Model.RecommendedResources)
                {
                    <div class="learn-item">
                        <div>
                            <span class="learn-tag learn-tag-gap">CLOSES: @r.SkillName.ToUpper()</span>
                            @if (r.Type == LearningResourceType.Certification)
                            {
                                <span class="learn-tag" style="background:rgba(242,163,64,0.16); color:#C97F1F;">CERTIFICATE</span>
                            }
                            <h4>@r.Title</h4>
                            <div class="meta">@r.Provider &middot; @r.DurationHours hrs</div>
                        </div>
                        <a class="go" href="@r.Url" target="_blank" rel="noopener">Start →</a>
                    </div>
                }
            }
            else
            {
                <p style="font-size:13.5px; color:var(--slate-light); margin:8px 0 0;">
                    @(m.GapSkills.Count == 0 ? "No skill gaps for this role — nothing to close." : "No catalogue resources yet for these gaps.")
                </p>
            }
        </div>
    </div>
</div>
