@model EditGraduateViewModel
@{
    ViewData["Title"] = "Edit " + Model.FullName;
    ViewData["PageTitle"] = "Edit Graduate";
    ViewData["Active"] = "Graduates";
    ViewData["UserName"] = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Admin";
    var nameForInitials = ViewData["UserName"] as string ?? "Admin";
    ViewData["UserInitials"] = string.Join("", nameForInitials.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(p => p[0])).ToUpper();
    Layout = "_AdminLayout";
}

<div class="form-page">
    <div class="card">
        <div class="card-head">
            <div>
                <h3>Edit account</h3>
                <div class="meta">Changes are saved to this graduate's account immediately.</div>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <form asp-controller="Admin" asp-action="EditGraduate" method="post">
            <input type="hidden" asp-for="GraduateId" />
            <div class="field">
                <label asp-for="FullName"></label>
                <input asp-for="FullName" type="text" />
                <span asp-validation-for="FullName" class="hint" style="color:var(--coral);"></span>
            </div>
            <div class="field">
                <label asp-for="PhoneNumber"></label>
                <input asp-for="PhoneNumber" type="tel" placeholder="000 000 0000" />
            </div>
            <div class="field">
                <label asp-for="StudentNumber"></label>
                <input asp-for="StudentNumber" type="text" />
            </div>
            <div class="field">
                <label asp-for="Qualification"></label>
                <input asp-for="Qualification" type="text" />
            </div>
            <div class="row-between" style="margin-top:4px;">
                <label><input asp-for="IsActive" /> Account active</label>
            </div>
            <button type="submit" class="btn btn-primary btn-block btn-lg">Save changes</button>
        </form>
    </div>
</div>
