@model AdminOverviewViewModel
@{
    ViewData["Title"] = "Admin overview";
    ViewData["PageTitle"] = "Admin overview";
    ViewData["Active"] = "Overview";
    ViewData["UserName"] = Model.AdminName;
    ViewData["UserInitials"] = string.Join("", Model.AdminName.Split(' ').Select(p => p.Length > 0 ? p[0] : ' ')).ToUpper();
    Layout = "_AdminLayout";
}

<div class="stat-row" style="grid-template-columns:repeat(4,1fr);">
    <div class="stat-card">
        <div class="lbl">TOTAL GRADUATES</div>
        <div class="val mono">@Model.TotalGraduates.ToString("N0")</div>
        <div class="delta">↑ @Model.NewGraduatesThisWeek this week</div>
    </div>
    <div class="stat-card">
        <div class="lbl">CVs ANALYSED (30D)</div>
        <div class="val mono">@Model.CvsAnalysedLast30Days.ToString("N0")</div>
        <div class="delta" style="color:var(--slate-light);">Last 30 days</div>
    </div>
    <div class="stat-card">
        <div class="lbl">AVG. MATCH SCORE</div>
        <div class="val mono">@Model.AverageMatchScore%</div>
        <div class="delta" style="color:var(--slate-light);">Platform-wide average</div>
    </div>
    <div class="stat-card">
        <div class="lbl">READY TO APPLY</div>
        <div class="val mono">@Model.GraduatesReadyToApplyCount.ToString("N0")</div>
        <div class="delta">@Model.GraduatesReadyToApplyPercent% have a 65%+ match</div>
    </div>
</div>

<div class="dash-grid">
    <div>
        <div class="card" style="margin-bottom:20px;">
            <div class="card-head">
                <div><h3>Most common skill gaps</h3><div class="meta">Aggregated across all matches</div></div>
                <span class="pill pill-teal">PLATFORM-WIDE</span>
            </div>
            @if (Model.TopSkillGaps.Count > 0)
            {
                @foreach (var gap in Model.TopSkillGaps)
                {
                    <div class="hbar-row">
                        <div class="hbar-top"><span>@gap.SkillName</span><span class="n">@gap.PercentOfGraduates% of matches</span></div>
                        <div class="hbar-track"><div class="hbar-fill" style="width:@(gap.PercentOfGraduates)%;"></div></div>
                    </div>
                }
            }
            else
            {
                <p style="font-size:13.5px; color:var(--slate-light); margin:0;">No analyses have run yet.</p>
            }
        </div>

        <div class="card">
            <div class="card-head">
                <div><h3>Recent activity</h3><div class="meta">Latest CV / job comparisons across the platform</div></div>
            </div>
            @if (Model.RecentActivity.Count > 0)
            {
                <table class="recent">
                    <tr><th>Graduate</th><th>Matched against</th><th>Date</th><th>Score</th></tr>
                    @foreach (var activity in Model.RecentActivity)
                    {
                        var badgeColor = activity.Score >= 70 ? "background:rgba(14,156,143,0.1); color:var(--teal-dark);"
                                        : activity.Score >= 50 ? "background:rgba(242,163,64,0.15); color:#C97F1F;"
                                        : "background:rgba(232,92,74,0.12); color:var(--coral);";
                        <tr>
                            <td>@activity.GraduateName<div class="sub">@activity.Qualification</div></td>
                            <td>@activity.JobTitle<div class="sub">@activity.Company</div></td>
                            <td>@activity.Date.ToString("d MMM yyyy")</td>
                            <td><span class="score-badge" style="@badgeColor">@activity.Score%</span></td>
                        </tr>
                    }
                </table>
            }
            else
            {
                <p style="font-size:13.5px; color:var(--slate-light); margin:0;">No activity yet.</p>
            }
        </div>
    </div>

    <div>
        <div class="card">
            <div class="card-head">
                <div><h3>Manage graduates</h3><div class="meta">@Model.TotalGraduates.ToString("N0") registered accounts</div></div>
                <a class="btn-text" asp-controller="Admin" asp-action="Graduates">View all →</a>
            </div>
            @foreach (var grad in Model.Graduates.Take(6))
            {
                var initials = string.Join("", grad.FullName.Split(' ').Select(p => p.Length > 0 ? p[0] : ' ')).ToUpper();
                var roleClass = grad.Role == "ADMIN" ? "role-admin" : "role-grad";
                <div class="admin-userlist">
                    <div class="avatar" style="width:32px;height:32px;font-size:11px;">@initials</div>
                    <div>
                        @if (grad.Role == "GRADUATE")
                        {
                            <a asp-controller="Admin" asp-action="GraduateDetail" asp-route-id="@grad.GraduateId" class="u-name" style="color:var(--ink);">@grad.FullName</a>
                        }
                        else
                        {
                            <div class="u-name">@grad.FullName</div>
                        }
                        <div class="u-email">@grad.Email</div>
                    </div>
                    <div class="u-meta">
                        <span class="role-badge @roleClass">@grad.Role</span>
                        <span><span class="status-dot" style="background:@(grad.IsActive ? "var(--teal)" : "var(--slate-light)");"></span></span>
                    </div>
                </div>
            }
        </div>

        @{ var dictTotal = Model.TechnicalSkillTermCount + Model.QualificationTermCount; }
        <div class="card" style="margin-top:20px;">
            <div class="card-head">
                <div><h3>Skills dictionary</h3><div class="meta">Powers keyword &amp; phrase matching</div></div>
                <a class="btn-text" asp-controller="Admin" asp-action="SkillsDictionary">Manage →</a>
            </div>
            <div class="bar-row">
                <div class="bar-top"><span>Technical skills</span><span class="mono">@Model.TechnicalSkillTermCount.ToString("N0") terms</span></div>
                <div class="bar-track"><div class="bar-fill" style="width:@(dictTotal == 0 ? 0 : 100 * Model.TechnicalSkillTermCount / dictTotal)%;"></div></div>
            </div>
            <div class="bar-row" style="margin-bottom:0;">
                <div class="bar-top"><span>Qualifications</span><span class="mono">@Model.QualificationTermCount.ToString("N0") terms</span></div>
                <div class="bar-track"><div class="bar-fill" style="width:@(dictTotal == 0 ? 0 : 100 * Model.QualificationTermCount / dictTotal)%; background:var(--amber);"></div></div>
            </div>
        </div>
    </div>
</div>
