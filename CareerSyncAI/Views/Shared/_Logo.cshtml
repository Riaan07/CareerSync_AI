@model string
@{
    var variant = Model ?? "light";
    var wordColor = variant == "dark" ? "#fff" : "var(--navy)";
}
<div class="logo-lockup">
    <svg width="26" height="26" viewBox="0 0 100 100" fill="none">
        <defs>
            <linearGradient id="logoGrad" x1="0" y1="0" x2="100" y2="100">
                <stop offset="0" stop-color="#0E9C8F" />
                <stop offset="1" stop-color="#122647" />
            </linearGradient>
        </defs>
        <circle cx="50" cy="50" r="40" stroke="url(#logoGrad)" stroke-width="12" fill="none"
                stroke-linecap="round" stroke-dasharray="205 251" transform="rotate(-90 50 50)" />
        <circle cx="50" cy="50" r="40" stroke="#F2A340" stroke-width="12" fill="none"
                stroke-linecap="round" stroke-dasharray="30 251" stroke-dashoffset="-206" transform="rotate(-90 50 50)" />
        <path d="M35 51 L45 61 L67 38" stroke="#122647" stroke-width="9" fill="none"
              stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span class="word" style="color:@wordColor;">Career<b>Sync</b></span>
</div>
