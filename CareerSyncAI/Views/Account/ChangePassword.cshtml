@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    ViewData["PageTitle"] = "Change Password";
    ViewData["Active"] = "ChangePassword";
    var isAdmin = User.IsInRole("Admin");
    ViewData["UserName"] = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "Account";
    var nameForInitials = ViewData["UserName"] as string ?? "Account";
    ViewData["UserInitials"] = string.Join("", nameForInitials.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(p => p[0])).ToUpper();
    Layout = isAdmin ? "_AdminLayout" : "_AppUserLayout";
}

@if (ViewData["StatusMessage"] is string status)
{
    <div class="status-banner">@status</div>
}

<div class="form-page">
    <div class="card">
        <div class="card-head">
            <div>
                <h3>Change password</h3>
                <div class="meta">Choose a new password — you'll need your current one to confirm it's you.</div>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <form asp-controller="Account" asp-action="ChangePassword" method="post">
            <div class="field">
                <label asp-for="CurrentPassword"></label>
                <div class="input-icon-wrap">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#93A2AF" stroke-width="2"><rect x="4" y="11" width="16" height="9" rx="2" /><path d="M8 11V7a4 4 0 018 0v4" /></svg>
                    <input asp-for="CurrentPassword" type="password" placeholder="••••••••••" />
                </div>
                <span asp-validation-for="CurrentPassword" class="hint" style="color:var(--coral);"></span>
            </div>
            <div class="field">
                <label asp-for="NewPassword"></label>
                <div class="input-icon-wrap">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#93A2AF" stroke-width="2"><rect x="4" y="11" width="16" height="9" rx="2" /><path d="M8 11V7a4 4 0 018 0v4" /></svg>
                    <input asp-for="NewPassword" type="password" placeholder="At least 8 characters" />
                </div>
                <span asp-validation-for="NewPassword" class="hint" style="color:var(--coral);"></span>
            </div>
            <div class="field">
                <label asp-for="ConfirmNewPassword"></label>
                <div class="input-icon-wrap">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#93A2AF" stroke-width="2"><rect x="4" y="11" width="16" height="9" rx="2" /><path d="M8 11V7a4 4 0 018 0v4" /></svg>
                    <input asp-for="ConfirmNewPassword" type="password" placeholder="••••••••••" />
                </div>
                <span asp-validation-for="ConfirmNewPassword" class="hint" style="color:var(--coral);"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-block btn-lg">Update password</button>
        </form>
        <div style="margin-top:14px; font-size:13px;">
            Forgot-password recovery uses your security questions.
            <a asp-controller="Account" asp-action="SecurityQuestions" style="color:var(--teal); font-weight:600;">Manage security questions →</a>
        </div>
    </div>
</div>
