@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Reset your password";
    Layout = "_AuthLayout";
}

<h2>Reset your password</h2>
<div class="sub">Enter the email you registered with, then choose how to confirm it's you.</div>

@if (ViewData["StatusMessage"] is string status)
{
    <div class="status-banner">@status</div>
}
<div asp-validation-summary="ModelOnly" class="validation-summary"></div>

<form asp-controller="Account" asp-action="ForgotPassword" method="post">
    <div class="field">
        <label asp-for="Email"></label>
        <input asp-for="Email" type="email" autocomplete="email" placeholder="" />
        <span asp-validation-for="Email" class="hint" style="color:var(--coral);"></span>
    </div>

    <fieldset class="recovery-options">
        <legend>@Html.DisplayNameFor(m => m.Method)</legend>

        <label class="recovery-option">
            <input type="radio" asp-for="Method" value="@PasswordRecoveryMethod.Sms" id="method-sms" />
            <span>
                <b>Text me a code</b>
                <small>We'll send a 6-digit code to the mobile number on your account. It expires in 10 minutes.</small>
            </span>
        </label>

        <label class="recovery-option">
            <input type="radio" asp-for="Method" value="@PasswordRecoveryMethod.SecurityQuestions" id="method-questions" />
            <span>
                <b>Answer my security questions</b>
                <small>No phone with you? Answer the two questions you chose when you registered.</small>
            </span>
        </label>
    </fieldset>

    <button type="submit" class="btn btn-primary btn-block btn-lg">Continue</button>
</form>
<div class="switch-line"><a asp-controller="Account" asp-action="Login" style="color:var(--teal);">← Back to sign in</a></div>
