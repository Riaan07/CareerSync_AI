@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Set a new password";
    Layout = "_AuthLayout";
}

<h2>Set a new password</h2>
<div class="sub">Choose a new password for @Model.Email. It must be at least 8 characters.</div>

<div asp-validation-summary="ModelOnly" class="validation-summary"></div>

<form asp-controller="Account" asp-action="ResetPassword" method="post">
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="Token" />
    <div class="field">
        <label asp-for="NewPassword"></label>
        <input asp-for="NewPassword" type="password" placeholder="At least 8 characters" />
        <span asp-validation-for="NewPassword" class="hint" style="color:var(--coral);"></span>
    </div>
    <div class="field">
        <label asp-for="ConfirmNewPassword"></label>
        <input asp-for="ConfirmNewPassword" type="password" placeholder="••••••••••" />
        <span asp-validation-for="ConfirmNewPassword" class="hint" style="color:var(--coral);"></span>
    </div>
    <button type="submit" class="btn btn-primary btn-block btn-lg">Reset password</button>
</form>
<div class="switch-line"><a asp-controller="Account" asp-action="Login" style="color:var(--teal);">← Back to sign in</a></div>
