@{
    ViewData["Title"] = "About";
}


<section class="bg-navy" style="padding: 3.5rem 0 4.5rem;">
    <div class="container">
        <span class="eyebrow on-dark"><i class="fa-solid fa-circle-info me-1"></i> About CareerSync AI</span>
        <h1 class="display-font fw-bold mt-3" style="color:#fff; font-size: clamp(2rem, 4vw, 3rem); max-width: 700px;">
            Built because "good luck with your search" isn't a strategy.
        </h1>
        <p class="mt-3" style="color: var(--csa-slate-light); max-width: 620px; font-size: 1.05rem;">
            CareerSync AI is a graduate employability platform designed to give South African graduates
            the kind of specific, structured feedback job boards were never built to provide.
        </p>
    </div>
</section>


<section class="section">
    <div class="container">
        <div class="row gy-5 align-items-start">
            <div class="col-lg-5">
                <span class="eyebrow">The Problem</span>
                <h2 class="display-font fw-bold mt-2" style="font-size: clamp(1.5rem, 3vw, 2rem);">
                    Graduates apply blind, again and again.
                </h2>
            </div>
            <div class="col-lg-7">
                <p class="text-muted-slate">
                    Most graduate job seekers in South Africa apply through platforms built for volume,
                    not clarity. Listings get filtered by applicant tracking systems before a human ever
                    reads them, and rejection arrives with no explanation — no sense of which
                    requirement was missed, or how close the application actually was.
                </p>
                <p class="text-muted-slate mb-0">
                    That silence is the gap CareerSync AI was built to close: turning a CV and a job
                    description into a transparent, weighted score and a concrete plan to improve it.
                </p>
            </div>
        </div>
    </div>
</section>


<section class="section bg-paper-2">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-7">
                <span class="eyebrow">What We Stand For</span>
                <h2 class="display-font fw-bold mt-2" style="font-size: clamp(1.5rem, 3vw, 2rem);">
                    Feedback that's specific, fair, and yours.
                </h2>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="csa-card">
                    <div class="icon-badge"><i class="fa-solid fa-bullseye"></i></div>
                    <h3 class="h5 fw-bold display-font">Specific Over Generic</h3>
                    <p class="text-muted-slate mb-0">
                        Every score and recommendation is calculated against
                        the exact job description you provide — never a generic template.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="csa-card">
                    <div class="icon-badge"><i class="fa-solid fa-scale-balanced"></i></div>
                    <h3 class="h5 fw-bold display-font">Algorithmic Fairness</h3>
                    <p class="text-muted-slate mb-0">
                        Matching logic is designed and reviewed to reduce
                        bias, so your score reflects your fit — not proxies that shouldn't matter.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="csa-card">
                    <div class="icon-badge"><i class="fa-solid fa-user-shield"></i></div>
                    <h3 class="h5 fw-bold display-font">Privacy-First</h3>
                    <p class="text-muted-slate mb-0">
                        Built with POPIA compliance in mind from the ground
                        up — your CV data is used to help you, not to profile you.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>


<section class="section">
    <div class="container">
        <div class="row align-items-center gy-5">
            <div class="col-lg-6">
                <span class="eyebrow">Where It Started</span>
                <h2 class="display-font fw-bold mt-2" style="font-size: clamp(1.5rem, 3vw, 2rem);">
                    An honours capstone project at UFS.
                </h2>
                <p class="text-muted-slate mt-3">
                    CareerSync AI began as a final-year Honours capstone at the University of the Free
                    State, built to address a gap in the current graduate employability landscape:
                    the lack of meaningful, structured feedback in existing job-search platforms.
                </p>
                <p class="text-muted-slate mb-0">
                    From literature on ATS filtering and NLP-based matching to real considerations
                    around POPIA compliance and algorithmic fairness, the platform is grounded in
                    research as much as in code.
                </p>
            </div>
            <div class="col-lg-6">
                <div class="csa-card" style="background: var(--csa-navy); border: none;">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="csa-dial-mini" style="--m:88%;"><i class="fa-solid fa-graduation-cap"></i></div>
                        <div>
                            <h3 class="h6 fw-bold display-font mb-0" style="color:#fff;">University of the Free State</h3>
                            <span class="mono" style="font-size:0.75rem; color: var(--csa-slate-light);">Honours Capstone Project</span>
                        </div>
                    </div>
                    <hr class="csa-divider-dark" />
                    <ul class="list-unstyled d-flex flex-column gap-2 mb-0" style="color: var(--csa-slate-light); font-size:0.92rem;">
                        <li><i class="fa-solid fa-check me-2" style="color: var(--csa-emerald);"></i>Web-based graduate employability platform</li>
                        <li><i class="fa-solid fa-check me-2" style="color: var(--csa-emerald);"></i>C# ASP.NET Core MVC · SQL Server · Azure</li>
                        <li><i class="fa-solid fa-check me-2" style="color: var(--csa-emerald);"></i>Grounded in literature on ATS &amp; NLP matching</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>


<section class="bg-navy" style="padding: 4rem 0;">
    <div class="container text-center">
        <h2 class="display-font fw-bold mb-3" style="color:#fff; font-size: clamp(1.5rem, 3vw, 2rem);">
            See how your CV actually stacks up.
        </h2>
        <a href="@Url.Action("Index", "Home")#how-it-works" class="btn btn-csa-solid-emerald btn-lg">
            <i class="fa-solid fa-arrow-up-right-from-square me-2"></i>Explore the Platform
        </a>
    </div>
</section>

