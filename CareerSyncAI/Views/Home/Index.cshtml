@{
    ViewData["Title"] = "Home";
    Layout = "_Layout";
}

<div class="hero-wrap">
    <div class="hero">
        <div>
            <span class="eyebrow">BUILT FOR UFS GRADUATES</span>
            <h1>Know exactly why the<br />interview <span class="accent">didn't come.</span></h1>
            <p class="lede">Upload your CV and the job you want. CareerSync AI scores the match, shows precisely which skills are missing, and points you to the course that closes the gap.</p>
            <div class="cta-row">
                <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Register">Upload your CV</a>
                <a class="btn btn-ghost btn-lg" href="#demo">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                    Watch the demo
                </a>
            </div>
            <div class="trust">No CV left unread — <b>every</b> upload gets a transparent, explained score.</div>
        </div>
        <div class="sync-visual">
            <div class="doc-card cv-card">
                <div class="dc-head"><div class="dc-dot" style="background:var(--teal);"></div><span class="dc-label">YOUR CV</span></div>
                <div class="dc-title">Sbahle_Dlamini_CV.pdf</div>
                <div class="doc-line" style="width:90%;"></div>
                <div class="doc-line" style="width:70%;"></div>
                <div class="doc-line" style="width:80%;"></div>
            </div>
            <div class="doc-card jd-card">
                <div class="dc-head"><div class="dc-dot" style="background:var(--navy);"></div><span class="dc-label">JOB POSTING</span></div>
                <div class="dc-title">Junior Software Developer</div>
                <div class="doc-line" style="width:85%;"></div>
                <div class="doc-line" style="width:60%;"></div>
                <div class="doc-line" style="width:75%;"></div>
            </div>
            <div class="sync-ring-holder">
                <svg width="190" height="190" viewBox="0 0 190 190">
                    <circle class="ring-bg" cx="95" cy="95" r="80"></circle>
                    <circle class="ring-fg" cx="95" cy="95" r="80"></circle>
                </svg>
                <div class="ring-center">
                    <div class="pct">78%</div>
                    <div class="lbl">MATCH SCORE</div>
                </div>
            </div>
            <div class="float-tag tag-1"><span class="dot" style="background:var(--teal);"></span>C# — matched</div>
            <div class="float-tag tag-2"><span class="dot" style="background:var(--coral);"></span>SQL Server — gap</div>
            <div class="float-tag tag-3"><span class="dot" style="background:var(--teal);"></span>REST APIs — matched</div>
        </div>
    </div>
</div>

<div class="section" id="how">
    <div class="section-head">
        <span class="eyebrow">HOW IT WORKS</span>
        <h2>From upload to a plan, in three steps.</h2>
    </div>
    <div class="steps">
        <div class="step-card">
            <div class="step-num">01 / UPLOAD</div>
            <h3>Upload your CV</h3>
            <p>Drop in your CV. CareerSync AI reads your skills, experience, and qualifications automatically.</p>
        </div>
        <div class="step-card">
            <div class="step-num">02 / STATE THE ROLE</div>
            <h3>Paste the job you want</h3>
            <p>Paste the description of the role you're applying for, right alongside your CV — no separate step.</p>
        </div>
        <div class="step-card">
            <div class="step-num">03 / GET YOUR SCORE</div>
            <h3>See your match &amp; plan</h3>
            <p>A clear percentage, the exact skills behind it, and the courses or certificates that would close the gap fastest.</p>
        </div>
    </div>
</div>

<div class="section demo-section" id="demo">
    <div class="section-head">
        <span class="eyebrow">SEE IT IN ACTION</span>
        <h2>The whole journey in 36 seconds.</h2>
        <p>Watch a CV and a job description go in, and a match score, skill breakdown and learning plan come out.</p>
    </div>

    <figure class="demo-player">
        <div class="demo-frame">
            <video id="demo-video"
                   controls
                   muted
                   playsinline
                   preload="metadata"
                   poster="~/media/careersync-demo-poster.jpg"
                   aria-describedby="demo-description">
                @* MP4 (H.264) plays in Chrome, Edge, Firefox and Safari; the WebM copy is a
                   fallback for browsers built without H.264 (e.g. some Linux Chromium builds). *@
                <source src="~/media/careersync-demo.mp4" type="video/mp4" />
                <source src="~/media/careersync-demo.webm" type="video/webm" />
                Your browser can't play this video.
                <a href="~/media/careersync-demo.mp4">Download the demo (MP4, 0.2 MB)</a> instead.
            </video>
        </div>

        @* Chapter buttons: jump to each step. Times match the video (6 s per section). *@
        <nav class="demo-chapters" aria-label="Jump to a part of the demo">
            <button type="button" data-time="0"><span class="t">0:00</span>Overview</button>
            <button type="button" data-time="6"><span class="t">0:06</span>Upload your CV</button>
            <button type="button" data-time="12"><span class="t">0:12</span>Add the target job</button>
            <button type="button" data-time="18"><span class="t">0:18</span>Analysis</button>
            <button type="button" data-time="24"><span class="t">0:24</span>Match score</button>
            <button type="button" data-time="30"><span class="t">0:30</span>Learning path</button>
        </nav>

        <figcaption id="demo-description">
            Demonstration (no sound): a CV is uploaded, a Data Analyst job is added, both are analysed,
            an 84% match score is shown with a per-skill breakdown, and the skill gaps become a
            prioritised learning path.
        </figcaption>
    </figure>
</div>

<div class="section" id="what-you-get">
    <div class="section-head">
        <span class="eyebrow">WHAT YOU GET</span>
        <h2>A score you can actually trust.</h2>
        <p>No black box. Every match is broken down by category, so you know precisely what to work on next.</p>
    </div>
    <div class="feature-grid">
        <div class="feature-card">
            <div class="feature-icon" style="background:rgba(14,156,143,0.1);">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0E9C8F" stroke-width="2"><circle cx="12" cy="12" r="9" /><path d="M8 12l3 3 5-6" /></svg>
            </div>
            <h4>Transparent match scoring</h4>
            <p>Weighted across skills, experience and qualifications — not a single opaque number.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon" style="background:rgba(232,92,74,0.1);">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E85C4A" stroke-width="2"><path d="M12 2l3 7h7l-5.5 4.5L18 21l-6-4-6 4 1.5-7.5L2 9h7z" /></svg>
            </div>
            <h4>Skill gap breakdown</h4>
            <p>See the exact keywords and competencies a posting expects that your CV doesn't show yet.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon" style="background:rgba(242,163,64,0.14);">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C97F1F" stroke-width="2"><path d="M4 19V6a2 2 0 012-2h9l5 5v10a2 2 0 01-2 2H6a2 2 0 01-2-2z" /></svg>
            </div>
            <h4>Personalised learning paths</h4>
            <p>Recommendations mapped directly to the gaps found in your most recent match.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon" style="background:rgba(18,38,71,0.08);">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#122647" stroke-width="2"><rect x="4" y="10" width="16" height="10" rx="2" /><path d="M8 10V7a4 4 0 018 0v3" /></svg>
            </div>
            <h4>Your documents, kept private</h4>
            <p>Your CV and the roles you check it against are stored securely and are never shared beyond your account.</p>
        </div>
    </div>
</div>

<div class="cta-band">
    <div>
        <h2>See your match score in under two minutes.</h2>
        <p>Free for UFS Computer Science &amp; Informatics graduates.</p>
    </div>
    <a class="btn btn-teal btn-lg" asp-controller="Account" asp-action="Register">Create free account</a>
</div>

@section Scripts {
    <script>
        // Demo video chapters: click to jump; highlight the chapter that's playing.
        (function () {
            var video = document.getElementById("demo-video");
            if (!video) return;
            var buttons = Array.prototype.slice.call(document.querySelectorAll(".demo-chapters button"));

            buttons.forEach(function (b) {
                b.addEventListener("click", function () {
                    video.currentTime = parseFloat(b.dataset.time);
                    var playing = video.play();
                    if (playing && playing.catch) playing.catch(function () { /* autoplay blocked: user can press play */ });
                });
            });

            function highlight() {
                var current = null;
                buttons.forEach(function (b) { if (video.currentTime + 0.05 >= parseFloat(b.dataset.time)) current = b; });
                buttons.forEach(function (b) {
                    var on = b === current && (video.currentTime > 0 || !video.paused);
                    b.classList.toggle("active", on);
                    if (on) b.setAttribute("aria-current", "true"); else b.removeAttribute("aria-current");
                });
            }
            video.addEventListener("timeupdate", highlight);
            video.addEventListener("seeked", highlight);
        })();
    </script>
}
